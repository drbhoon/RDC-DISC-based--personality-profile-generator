# RDC People Science Platform — Environment Variables
# Copy this file to .env for local development.
# On Railway, set all variables in the Railway dashboard — never commit .env

# PostgreSQL connection string (auto-set by Railway PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@localhost:5432/rdc_people_science

# Strong random string for signing admin JWTs
# Generate: openssl rand -hex 32
JWT_SECRET=replace_with_openssl_rand_hex_32

# Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Initial admin credentials (used to seed DB on first deploy)
ADMIN_USERNAME=admin
# bcrypt hash of admin password — generate with:
# node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=$2a$12$...

# Full public URL of deployment (used to construct assessment links)
APP_URL=http://localhost:3001

# ── E-mail (candidate invitations) ──────────────────────────────────────────
# The SAME shared SMTP settings every HR app on the platform uses — on the
# server these come from the single umbrella .env, so nothing extra is needed
# there once the disc service is given them in docker-compose. SMTP_FROM is the
# standard noreply@rdc.in. secure is implied by SMTP_PORT=465.
# If left unset, the invite button returns a clear "e-mail not configured" error
# and nothing else is affected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@rdc.in

# Set to 'production' on Railway
NODE_ENV=development

# Auto-set by Railway — Express uses this
PORT=3001
